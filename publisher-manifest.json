nt-weight: 700;letter-spacing: 0.1em}\n  .ticket-tag.featured {background: var(--accent);color: #fff}\n  .ticket-price {font-size: 32px;font-weight: 800;color: var(--accent);margin-bottom: 4px}\n  .ticket-price small {font-size: 14px;color: var(--ink-muted);font-weight: 500}\n  .ticket-annual {font-size: 13px;color: var(--ink-soft);margin-bottom: 24px}\n  .ticket-list {list-style: none;display: grid;gap: 12px}\n  .ticket-list li {font-size: 15px;color: var(--ink);padding-left: 22px;position: relative}\n  .ticket-list li::before {content: \"\";position: absolute;left: 0;top: 10px;width: 12px;height: 2px;background: var(--accent)}\n  .ticket-action {margin-top: 28px;display: flex;gap: 12px;flex-wrap: wrap}\n  .ticket-action a {font-size: 14px;text-decoration: none;padding: 10px 20px;border-radius: 6px;font-weight: 600;transition: opacity 0.2s}\n  .btn-main {background: var(--accent);color: #fff}\n  .btn-main:hover {opacity: 0.88}\n  .btn-ghost {border: 1.5px solid var(--accent);color: var(--accent)}\n  .btn-ghost:hover {background: var(--accent-soft)}\n  .usage {display: grid;grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));gap: 20px}\n  .step-card {background: var(--paper);border: 1px dashed var(--dash);padding: 28px;border-radius: 8px;position: relative}\n  .step-num {font-size: 48px;font-weight: 900;color: var(--accent-soft);line-height: 1;margin-bottom: 12px;position: absolute;top: 16px;right: 20px}\n  .step-card h3 {font-size: 17px;margin-bottom: 8px;font-weight: 700;position: relative;z-index: 2}\n  .step-card p {font-size: 14px;color: var(--ink-soft);position: relative;z-index: 2}\n  .faq-wrap {display: flex;flex-direction: column;gap: 14px}\n  details {background: var(--paper);border: 1px solid var(--line);border-radius: 8px;padding: 0;overflow: hidden;transition: border-color 0.2s}\n  details[open] {border-color: var(--accent)}\n  summary {padding: 20px 24px;font-weight: 600;font-size: 16px;cursor: pointer;list-style: none;display: flex;justify-content: space-between;align-items: center;gap: 16px}\n  summary::-webkit-details-marker {display: none}\n  summary::after {content: \"+\";font-size: 22px;color: var(--accent);font-weight: 300;transition: transform 0.2s;flex-shrink: 0}\n  details[open] summary::after {transform: rotate(45deg)}\n  .faq-content {padding: 0 24px 24px;font-size: 15px;color: var(--ink-soft);line-height: 1.75}\n  .footer {background: var(--bg-deep);padding: 48px 24px;text-align: center;font-size: 13px;color: var(--ink-muted);border-top: 1px solid var(--line)}\n  .footer a {color: var(--accent);text-decoration: none;margin: 0 8px}\n  @media (max-width: 600px) {\n    .hero-name {font-size: 28vw}\n    .hero-desc {position: static;max-width: 100%;margin-top: 40px}\n    .hero-jump {position: static;margin-top: 24px;flex-direction: row;flex-wrap: wrap}\n    .section {padding: 60px 18px}\n    .ticket {padding: 24px}\n  }\n</style><section class=\"hero\" id=\"top\">\n  <div class=\"hero-tag\">XSUS / 订阅服务</div>\n  <h1 class=\"hero-name\">XS<span>U</span>S</h1>\n  <div class=\"hero-desc\">\n    按月订阅的网络中转服务。不打包卖点，只按流量、设备数、路由规则三个维度配置你实际需要的通道。\n  </div>\n  <nav class=\"hero-jump\">\n    <a href=\"#intro\">服务说明</a>\n    <a href=\"#plans\">订阅套餐</a>\n    <a href=\"#usage\">使用步骤</a>\n    <a href=\"#faq\">常见问题</a>\n  </nav>\n</section>\n\n<main>\n  <section class=\"section\" id=\"intro\">\n    <div class=\"section-label\">02 / 服务说明</div>\n    <h2>三条主线，不绕弯子</h2>\n    <div class=\"intro-grid\">\n      <div>\n        <h3>流量计费</h3>\n        <p>每月固定额度，用完即止，不降速不额外扣费。适合可预估使用量的场景。</p>\n      </div>\n      <div>\n        <h3>设备并发</h3>\n        <p>同一订阅链接可同时在多台设备激活，超出上限的设备会被挤下线，不锁机。</p>\n      </div>\n      <div>\n        <h3>线路分层</h3>\n        <p>普通节点池与 IPLC 专线分开。基础套餐走普通池，旗舰及以上含专线配额。</p>\n      </div>\n      <div>\n        <h3>路由规则</h3>\n        <p>客户端支持自定义分流规则。团队版可由后台统一下发企业路由策略。</p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"plans\">\n    <div class=\"section-label\">03 / 订阅套餐</div>\n    <h2>按需选档，年付有折扣</h2>\n\n    <div class=\"plans-wrap\">\n\n      <article class=\"ticket\">\n        <div class=\"ticket-head\">\n          <div>\n            <div class=\"ticket-name\">基础版</div>\n            <span class=\"ticket-tag\">入门</span>\n          </div>\n        </div>\n        <div class=\"ticket-price\">¥15<small>/月</small></div>\n        <div class=\"ticket-annual\">按年付仅需 ¥150/年（等同免两月）</div>\n        <ul class=\"ticket-list\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <div class=\"ticket-action\">\n          <a href=\"#\" class=\"btn-main\">按月订阅</a>\n          <a href=\"#\" class=\"btn-ghost\">按年订阅</a>\n        </div>\n      </article>\n\n      <article class=\"ticket\">\n        <div class=\"ticket-head\">\n          <div>\n            <div class=\"ticket-name\">旗舰版</div>\n            <span class=\"ticket-tag featured\">推荐</span>\n          </div>\n        </div>\n        <div class=\"ticket-price\">¥35<small>/月</small></div>\n        <div class=\"ticket-annual\">按年付仅需 ¥350/年（等同免两月）</div>\n        <ul class=\"ticket-list\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <div class=\"ticket-action\">\n          <a href=\"#\" class=\"btn-main\">按月订阅</a>\n          <a href=\"#\" class=\"btn-ghost\">按年订阅</a>\n        </div>\n      </article>\n\n      <article class=\"ticket\">\n        <div class=\"ticket-head\">\n          <div>\n            <div class=\"ticket-name\">团队版</div>\n            <span class=\"ticket-tag\">企业</span>\n          </div>\n        </div>\n        <div class=\"ticket-price\">¥85<small>/月</small></div>\n        <div class=\"ticket-annual\">按年付仅需 ¥850/年（等同免两月）</div>\n        <ul class=\"ticket-list\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <div class=\"ticket-action\">\n          <a href=\"#\" class=\"btn-main\">按月订阅</a>\n          <a href=\"#\" class=\"btn-ghost\">联系商务</a>\n        </div>\n      </article>\n\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"usage\">\n    <div class=\"section-label\">04 / 使用步骤</div>\n    <h2>四步上线</h2>\n    <div class=\"usage\">\n      <div class=\"step-card\">\n        <div class=\"step-num\">01</div>\n        <h3>选择套餐并支付</h3>\n        <p>在订阅页选择对应档位，完成按月或按年付款后账户立即开通。</p>\n      </div>\n      <div class=\"step-card\">\n        <div class=\"step-num\">02</div>\n        <h3>复制订阅链接</h3>\n        <p>登录用户后台，在\"我的订阅\"中复制专属链接，链接长期有效可随时重置。</p>\n      </div>\n      <div class=\"step-card\">\n        <div class=\"step-num\">03</div>\n        <h3>导入客户端</h3>\n        <p>在 Clash、Shadowrocket、v2rayN 等支持订阅的客户端中粘贴链接并更新。</p>\n      </div>\n      <div class=\"step-card\">\n        <div class=\"step-num\">04</div>\n        <h3>选择节点连接</h3>\n        <p>在节点列表中选择延迟合适的线路，开启系统代理即可开始使用。</p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"faq\">\n    <div class=\"section-label\">05 / 常见问题</div>\n    <h2>先把疑问说清楚</h2>\n    <div class=\"faq-wrap\">\n\n      <details>\n        <summary>流量用完后还能上网吗？</summary>\n        <div class=\"faq-content\">\n          不能。每月流量额度用完后中转通道会暂停，直到下个账期自动恢复。你可以在后台提前购买加油包，或升级到更高档位套餐，不会产生未经确认的自动扣费。\n        </div>\n      </details>\n\n      <details>\n        <summary>支持哪些客户端？</summary>\n        <div class=\"faq-content\">\n          支持所有兼容通用订阅格式的客户端，包括 Windows 与 macOS 的 Clash、v2rayN、Sing-box；iOS 的 Shadowrocket、Quantumult X；Android 的 Clash for Android、v2rayNG。后台不提供客户端程序下载，请自行从各自官方渠道获取。\n        </div>\n      </details>\n\n      <details>\n        <summary>设备数超出上限会怎样？</summary>\n        <div class=\"faq-content\">\n          同时在线设备数超过套餐上限时，最早连接的设备会被自动挤下线，不会锁定设备硬件。如果你频繁切换设备，建议选择设备数更宽裕的档位，或使用支持多端口分流的客户端配置。\n        </div>\n      </details>\n\n      <details>\n        <summary>年付和月付的功能有区别吗？</summary>\n        <div class=\"faq-content\">\n          没有区别。年付与月付在同一套餐档位下享受完全相同的节点、流量和功能，仅付款周期和价格不同。年付相当于免两个月费用，不附带额外绑定条款。\n        </div>\n      </details>\n\n      <details>\n        <summary>可以退款或中途退订吗？</summary>\n        <div class=\"faq-content\">\n          订阅服务属于虚拟商品，开通后原则上不支持无理由退款。如遇线路大面积不可用超过 48 小时且无法修复，可按未使用天数比例申请补偿，具体以工单回复为准。\n        </div>\n      </details>\n\n      <details>\n        <summary>团队版的企业路由怎么配置？</summary>\n        <div class=\"faq-content\">\n          团队版用户可在管理后台为不同子账号配置独立分流规则，例如指定某办公室 IP 段走专线、其余走普通池。配置变更后客户端在下次订阅更新时自动拉取新策略，无需手动重装。\n        </div>\n      </details>\n\n    </div>\n  </section>\n</main>\n\n<footer class=\"footer\">\n  <div>\n    <a href=\"#top\">回到顶部</a>\n    ·\n    <a href=\"#plans\">查看套餐</a>\n    ·\n    <a href=\"#faq\">常见问题</a>\n  </div>\n  <p>XSUS — 按流量、按设备、按路由配置的网络中转订阅服务。</p>\n</footer>",
